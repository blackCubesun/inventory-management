import pandas as pd
import os

PROCESSED = r'C:\Users\92585\Desktop\Sklad_System\data\processed'

# Смотрим ВПути и Резервы
for f in ['Резервы_плоский.xlsx', 'ВПути_плоский.xlsx', 'Цена_плоский.xlsx']:
    try:
        df = pd.read_excel(os.path.join(PROCESSED, f))
        if 'СТО' in df.columns:
            print(f'\n=== {f} ===')
            sto_list = sorted(df['СТО'].unique())
            print(f'СТО: {len(sto_list)}')
            for s in sto_list:
                print(f'  {s}')
        else:
            print(f'\n=== {f} ===')
            print(f'Нет столбца СТО. Колонки: {list(df.columns)}')
    except Exception as e:
        print(f'{f}: {e}')