import sqlite3
import pandas as pd

DB_PATH = r'C:\Users\92585\Desktop\Sklad_System\data\sklad.db'
conn = sqlite3.connect(DB_PATH)

q_inner = """
SELECT COUNT(*) as cnt from Модель m
INNER JOIN Остатки o ON m.Код = o.Код and m.СТО = o.СТО;
"""

q_left = """
SELECT COUNT(*) as cnt from Модель m
LEFT JOIN Остатки o ON m.Код = o.Код and m.СТО = o.СТО;
"""

print('INNER:', pd.read_sql(q_inner, conn)['cnt'].iloc[0])
print('LEFT:', pd.read_sql(q_left, conn)['cnt'].iloc[0])

conn.close()