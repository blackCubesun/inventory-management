import pandas as pd
import os
import re

RAW = r'C:\Users\92585\Desktop\Sklad_System\data\raw'
PROCESSED = r'C:\Users\92585\Desktop\Sklad_System\data\processed'

df = pd.read_excel(os.path.join(RAW, 'Пробег.xlsx'), skiprows=5, header=0)

# Убираем пустые строки
df = df.dropna(subset=['Автомобиль'])

# Извлекаем дату из "Последнее ТО"
def extract_date(s):
    if pd.isna(s):
        return None
    match = re.search(r'от (\d{2}\.\d{2}\.\d{4})', str(s))
    if match:
        return match.group(1)
    return None

df['ДатаТО'] = df['Последнее ТО'].apply(extract_date)
df['ДатаТО'] = pd.to_datetime(df['ДатаТО'], format='%d.%m.%Y', errors='coerce')
df['Месяц'] = df['ДатаТО'].dt.to_period('M').astype(str)

# Оставляем только ГУП Мосгортранс (пассажирские)
df = df[df['Владелец'] == 'ГУП "Мосгортранс"']

# Приводим числовые
df['Пробег в день'] = pd.to_numeric(df['Пробег в день'], errors='coerce')

# Агрегация по месяцам
monthly = df.groupby('Месяц').agg({
    'Пробег в день': 'mean',
    'Автомобиль': 'count'
}).reset_index()
monthly.columns = ['Месяц', 'СреднийПробегВДень', 'КоличествоТО']

print(monthly)
monthly.to_excel(os.path.join(PROCESSED, 'Пробег_месячный.xlsx'), index=False)
print('\nСохранено: Пробег_месячный.xlsx')