import sqlite3
import pandas as pd

DB_PATH = r'C:\Users\92585\Desktop\Sklad_System\data\sklad.db'
conn = sqlite3.connect(DB_PATH)

# ЗАДАНИЕ 1: Вывести все столбцы из Модели_v2 для СТО "Подразделение 13э (Митино)", где зона = "Крит". Ограничить 10 строками.
query1 = """
SELECT * From Модель_v2
WHERE СТО = 'Подразделение 13Э (Митино)'
    AND Зона = 'Крит'
LIMIT 10
"""

# ЗАДАНИЕ 2: Вывести СТО, Код, Наименование, ОстатокСТО для позиций, где ОстатокСТО > 100. Ограничить 15 строками.
query2 = """
SELECT СТО, Код, Наименование, ОстатокСТО
From Модель_v2
WHERE ОстатокСТО > 100
LIMIT 15
"""

# ЗАДАНИЕ 3: Вывести СТО, Код, Наименование для позиций, где наименование содержит "фильтр". Ограничить 12 строками.
query3 = """
SELECT СТО, Код, Наименование
From Модель_v2
WHERE Наименование LIKE '%ильтр%'
LIMIT 12
"""

# ЗАДАНИЕ 4: Посчитать количество позиций по каждой зоне в таблице Модель_v2. Отсортировать по убыванию количества.
query4 = """
SELECT Зона, COUNT(*) as Позиции
From Модель_v2
GROUP BY Зона
ORDER BY Позиции DESC
"""

# ЗАДАНИЕ 5: Посчитать сумму остатков (SUM(ОстатокСТО) по каждой СТО. Отсортировать по убыванию.
# Ограничить 10 строками.
query5 = """
SELECT СТО, SUM(ОстатокСТО) as ОбщийОстаток
From Модель_v2
GROUP BY СТО
ORDER BY ОбщийОстаток DESC
LIMIT 10;
"""

# ЗАДАНИЕ 6: Посчитать средний расход (AVG(Расход12мес) по каждой категории ABC_XYZ. Отсортировать по убыванию среднего. 
query6 = """
SELECT ABC_XYZ, AVG(Расход12мес) as РасходСреднее
From Модель_v2
GROUP BY ABC_XYZ
ORDER BY РасходСреднее DESC
LIMIT 15;
"""

# ЗАДАНИЕ 7: Соединить Модель_v2 и Остатки через INNER JOIN по Код и СТО. Вывести, СТО, Код, Наименование, Остаток. Ограничить 10 строками.
query7 = """
SELECT m.СТО, m.Код, m.Наименование, o.Остаток
From Модель_v2 m
INNER JOIN Остатки o ON m.СТО = o.СТО AND m.Код = o.Код
LIMIT 10;
"""

# ЗАДАНИЕ 8: Соединить Модель_v2 и Остатки через LEFT JOIN по Код и СТО. Вывести СТО, Код, Наименование, Остаток. Ограничить 10 строками.
query8 = """
SELECT m.СТО, m.Код, m.Наименование, o.Остаток
From Модель_v2 m
LEFT JOIN Остатки o ON m.СТО = o.СТО AND m.Код = o.Код
LIMIT 10;
"""

# ЗАДАНИЕ 9: Посчитать количество позиций по каждой СТО и каждой зоне одновременно (группировка по двум столбцам). Отсортировать по СТО и Зоне.
query9 = """
SELECT СТО, Зона, COUNT(*) as Позиции
From Модель_v2
GROUP BY СТО, Зона
ORDER BY СТО DESC, Зона DESC
"""

# ЗАДАНИЕ 10: Вывести топ-5 позиций с максимальным ОстатокСТО. Показать СТО, Код, Наименование, ОстатокСТО.
query10 = """
SELECT СТО, Код, Наименование, ОстатокСТО
From Модель_v2
ORDER BY ОстатокСТО DESC
LIMIT 5
"""

for i, q in enumerate([query1, query2, query3, query4, query5, query6, query7, query8, query9, query10], 1):
    print(f'\n=== ЗАПРОС {i}===')
    try:
        df = pd.read_sql(q, conn)
        print(df)
    except Exception as e:
        print(f'Ошибка: {e}')

conn.close()

