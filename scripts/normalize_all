import pandas as pd
import os

RAW = r'C:\Users\92585\Desktop\Sklad_System\data\raw'
PROCESSED = r'C:\Users\92585\Desktop\Sklad_System\data\processed'

# ========== ОСТАТКИ ==========
def normalize_ostatki():
    df = pd.read_excel(os.path.join(RAW, 'Остатки.xlsx'), skiprows=8, header=0)
    df = df.rename(columns={
        'Номенклатура.Код': 'Код',
        'Номенклатура.!SKN (Код)': 'SKN',
        'Номенклатура.№ по кат.': 'Артикул',
        'Номенклатура.Наименование': 'Наименование'
    })
    df = df[df['Код'].notna()]
    df = df[df['Код'] != 'Итого']
    df = df.drop(columns=['Итого'], errors='ignore')
    key_cols = ['Код', 'SKN', 'Артикул', 'Наименование']
    sto_cols = [c for c in df.columns if c not in key_cols]
    df_flat = df.melt(id_vars=key_cols, value_vars=sto_cols, var_name='СТО', value_name='Остаток')
    df_flat = df_flat[df_flat['Остаток'].notna()]
    df_flat.to_excel(os.path.join(PROCESSED, 'Остатки_плоский.xlsx'), index=False)
    print(f'✓ Остатки: {df_flat.shape}')

# ========== ВПУТИ ==========
